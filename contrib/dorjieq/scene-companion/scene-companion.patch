+// The dashboard with Make it yours → Companion open; 'sea' stands in for a scene that ships a companion (the packaged ones do not).
+const checked=Pet.validate(horse);
+function dashboard(settings,{own=null,fail='',open=true,features=id=>id!=='planner'}={}){
+ const calls={fetch:[],validate:0,renders:0};
+ const h=fixture({setup({env,store}){
+  for(const file of ['workspace-arrange.js','customization-model.js','study-kind.js','pony-brain.js','pet-art.js','pets.js','settings-dock.js','customize-ui.js'])vm.runInContext(read(file),env,{filename:file});
+  env.ReserveFeatures={enabled:features};Object.assign(store.get().settings,plain(settings));store.get().pet={name:'Biscuit'};
+  env.ReserveMakeYourOwn={activeLook:()=>({key:null,layer:{}}),picker:()=>'',render:()=>'',create:()=>({state:{pet:own},destroy(){}})};
+  env.ReserveSceneThemes={apply:()=>{calls.renders++;},remove(){},companion:id=>id==='sea'?SEA:''};
+  env.chrome={runtime:{getURL:file=>'chrome-extension://scene/'+file}};
+  env.fetch=async url=>{calls.fetch.push(url);return {ok:fail!=='read',text:async()=>horse};};
+  env.ReservePetPack={validate:async()=>{calls.validate++;if(fail==='check')throw Error('Invalid pack');return checked;}};
+ }});
+ if(open){h.click('settings');h.container.querySelector('[data-rd-action="customize-tab"][data-value="pet"]').click();}
+ return {h,calls,hero:()=>h.container.querySelector('.cz-pet-hero .pet').innerHTML,arrive:async()=>{await checked;h.tick(400);await settle();}};
+}
