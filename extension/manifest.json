{
  "manifest_version": 3,
  "name": "Canvas Harness",
  "short_name": "Canvas Harness",
  "version": "4.2.0",
  "description": "For students on Canvas LMS: every course, assignment and deadline on one calm page, with a planner, study rooms and themes.",
  "minimum_chrome_version": "126",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen",
    "scripting",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*",
    "https://www.kimi.com/*",
    "https://chat.qwen.ai/*",
    "https://chat.z.ai/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://flzsh.github.io/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.instructure.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Canvas Harness",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "js": [
        "site.js",
        "features.js",
        "startup-art.js",
        "startup.js",
        "page-switch.js"
      ],
      "css": [
        "startup.css",
        "startup-art.css",
        "canvas-nav.css",
        "course-nav.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "js": [
        "site.js",
        "core.js",
        "api.js",
        "personal-work.js",
        "custom-art.js",
        "workspace-arrange.js",
        "canvas-nav.js",
        "course-nav-art.js",
        "course-nav.js",
        "feature-loader.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
