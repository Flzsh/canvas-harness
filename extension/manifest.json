      ],
      "matches": [
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; worker-src 'self'"
  },
  "version_name": "3.4.0"
}
