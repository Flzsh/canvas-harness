{
  "manifest_version": 3,
  "name": "Canvas Harness",
  "short_name": "Canvas Harness",
  "version": "3.2.1",
  "description": "A Canvas workspace you build yourself: assignments beside their instructions, a weekly planner, study tools and a study companion.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*",
    "https://www.kimi.com/*",
    "https://chat.qwen.ai/*",
    "https://chat.z.ai/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.instructure.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Canvas Harness",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "js": [
        "features.js",
        "site.js",
        "startup-art.js",
        "startup.js"
      ],
      "css": [
        "startup.css",
        "startup-art.css",
        "canvas-nav.css",
        "course-nav.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "js": [
        "site.js",
        "core.js",
        "api.js",
        "personal-work.js",
        "custom-art.js",
        "workspace-arrange.js",
        "canvas-nav.js",
        "course-nav-art.js",
        "course-nav.js",
        "feature-loader.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "app.css",
        "dashboard.css",
        "workspace.css",
        "refresh.css",
        "native-page.css",
        "fonts/literata-latin.woff2",
        "fonts/literata-latin-italic.woff2",
        "customize.css",
        "subject-art.css",
        "ai-panel.html",
        "gpa.css",
        "icon.svg",
        "settings-dock.css",
        "selection.css",
        "responsive-layout.css",
        "widgets.css",
        "pet.css",
        "canvas-nav.css",
        "course-nav-art.css",
        "course-nav.css",
        "modules-page.css",
        "pdf-reader.html",
        "pdf-host.css"
      ],
      "matches": [
        "https://*.instructure.com/*"
      ]
    },
    {
      "resources": [
        "app.css",
        "dashboard.css",
        "workspace.css",
        "refresh.css",
        "native-page.css",
        "fonts/literata-latin.woff2",
        "fonts/literata-latin-italic.woff2",
        "customize.css",
        "subject-art.css",
        "ai-panel.html",
        "gpa.css",
        "icon.svg",
        "settings-dock.css",
        "selection.css",
        "responsive-layout.css",
        "widgets.css",
        "pet.css",
        "canvas-nav.css",
        "course-nav-art.css",
        "course-nav.css",
        "modules-page.css"
      ],
      "matches": [
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; worker-src 'self'"
  },
  "version_name": "3.2.1"
}
