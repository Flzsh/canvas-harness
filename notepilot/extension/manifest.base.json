{
  "manifest_version": 3,
  "name": "NotePilot AI",
  "version": "0.0.0",
  "description": "Keeps a live, AI-organized and rewritten copy of your Google Docs notes in the side panel. Never edits your document.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Open NotePilot AI",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "identity", "storage", "unlimitedStorage"],
  "host_permissions": ["https://docs.google.com/document/*", "https://docs.googleapis.com/*", "https://www.googleapis.com/upload/drive/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/documents.readonly"]
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+N" }, "description": "Open NotePilot AI" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'"
  }
}
