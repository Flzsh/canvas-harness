PORT=8787
# Any OpenAI-compatible upstream.
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=
# Comma-separated user:token pairs. Give each student/teacher their own token.
ACCESS_TOKENS=alice:change-me-long-random-token
# Optional comma-separated allowlist of models (empty = any).
ALLOWED_MODELS=gpt-5.4-mini,gpt-5.4
# Per-user limits.
RATE_LIMIT_PER_MIN=30
DAILY_TOKEN_LIMIT=2000000
# chrome-extension://<your extension id> (comma-separated). Empty = no CORS headers.
ALLOWED_ORIGINS=
# Optional path for a JSON-lines usage log (counts only, never content).
USAGE_LOG=
